# shellcheck shell=bash disable=SC2034,SC2154
# Generated by scripts/release.py; dependencies come from packaging/dependencies.json.
pkgbase=keytop
pkgname=('keytop' 'keytop-privileged-access')
pkgver=@PKGVER@
pkgrel=@PKGREL@
pkgdesc='Linux system metrics as JSON/JSONL and a terminal monitor'
arch=('x86_64')
url='https://github.com/StatIndet/keytop'
license=('GPL-3.0-or-later')
makedepends=@MAKEDEPENDS@
checkdepends=@CHECKDEPENDS@
source=("keytop-${pkgver}.tar.gz::${url}/releases/download/v${pkgver}/keytop-${pkgver}.tar.gz")
sha256sums=('@SHA256@')

build() {
    cmake -S "keytop-${pkgver}" -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=ON -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build build
}

check() {
    ctest --test-dir build --output-on-failure --no-tests=error
    test "$(build/bin/keytop --version)" = "keytop ${pkgver}"
}

package_keytop() {
    depends=@KEYTOP_DEPENDS@
    optdepends=@KEYTOP_OPTDEPENDS@
    DESTDIR="${pkgdir}" cmake --install build
}

package_keytop-privileged-access() {
    pkgdesc='Optional CAP_PERFMON and CAP_DAC_READ_SEARCH authorization for keytop'
    arch=('any')
    depends=@KEYTOP_PRIVILEGED_ACCESS_DEPENDS@
    install=keytop-privileged-access.install
    cd "keytop-${pkgver}" || return
    install -Dm755 packaging/arch/keytop-capabilities.sh "${pkgdir}/usr/lib/keytop/privileged-access"
    install -Dm644 packaging/arch/keytop-privileged-access.hook "${pkgdir}/usr/share/libalpm/hooks/keytop-privileged-access.hook"
    install -Dm644 docs/installation.md "${pkgdir}/usr/share/doc/keytop-privileged-access/installation.md"
}
