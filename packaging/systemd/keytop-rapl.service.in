[Unit]
Description=Keytop RAPL power measurement helper
Requires=keytop-rapl.socket
After=keytop-rapl.socket

[Service]
ExecStart=@CMAKE_INSTALL_FULL_LIBEXECDIR@/keytop/clavis-rapl-helper --serve
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadOnlyPaths=-/sys/class/powercap
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
SystemCallArchitectures=native
